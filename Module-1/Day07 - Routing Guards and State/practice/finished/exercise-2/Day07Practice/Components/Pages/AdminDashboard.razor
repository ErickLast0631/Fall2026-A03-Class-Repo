@page "/admin"
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<UserState> UserState
@inject NavigationManager Navigation

<h3>Admin Dashboard</h3>

<div class="alert alert-success">
    <h5>Welcome, Admin!</h5>
    <p>You have full access to the admin dashboard.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Users</h5>
                <p class="card-text">Manage user accounts</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Products</h5>
                <p class="card-text">Manage product catalog</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Orders</h5>
                <p class="card-text">View and process orders</p>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Practice 1: the demo's guard pattern on a different slice — read Role instead of
        // cart Items. Same discipline: decide in OnInitialized (before first render), redirect,
        // then return so nothing runs against the page the router is abandoning.
        if (UserState.Value.Role != "Admin")
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }
    }
}
